# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# UW_API_TOKEN: Optional Unusual Whales API Bearer token for live https://api.unusualwhales.com/api proxy.
UW_API_TOKEN=""

# ALPACA_API_KEY & ALPACA_SECRET_KEY: Live Alpaca Market Data v2 credentials for 1m/5m OHLCV, technical indicators, and lit stock trades.
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""

# LLM_API_KEY / LM_API_TOKEN: Optional Bearer token if LM Studio Server has "Require Authentication" enabled.
LLM_API_KEY=""
LM_API_TOKEN=""


